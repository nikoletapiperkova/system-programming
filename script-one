#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <sys/wait.h>
#include <fcntl.h>

int main(int argc, char *argv[]) {
    if (argc != 3) {
        printf("ERROR");
        exit(1);
    }

    char *filename = argv[1];
    char *command = argv[2];


    char *grepCommand[] = { "grep", "i", "f1", NULL };

    if (fork() == 0) {
        execvp(grepCommand[0], grepCommand);
        perror("execvp failed");
        exit(EXIT_FAILURE);
    } else {
        wait(NULL);  // Wait for the grep command to complete
    }


    pid_t pid = fork();
    if (pid == -1) {
        perror("fork failed");
        exit(EXIT_FAILURE);
    }

    if (pid == 0) {

        char *userCommand[] = { command, NULL };
        execvp(userCommand[0], userCommand);
        perror("execvp failed");
        exit(EXIT_FAILURE);
    } else {

        int status;
        waitpid(pid, &status, 0);

        printf("Command executed by process with PID: %d\n", pid);


        if ( status  == 0) {
            int fd = open(filename, O_WRONLY | O_APPEND | O_CREAT, 0644);
            if (fd == -1) {
                perror("open failed");
                exit(EXIT_FAILURE);
            }
            write(fd, command, strlen(command));
            write(fd, "\n", 1);
            close(fd);
        }
    }

    return 0;
}
