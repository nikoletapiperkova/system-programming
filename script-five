#include <unistd.h>
#include <sys/types.h>
#include <sys/stat.h>
#include <fcntl.h>
#include <stdio.h>
#include <errno.h>
#include <stdlib.h>

int main(int argc, char* argv[]) {
    char* firstCommand = argv[1];
    char* secondCommand = argv[2];

    int pid1, status1, pid2, status2;
    if(pid1 = fork()) {
      wait(&status1);
      if(status1 != 0) {
       exit(1);
      }
    } else {
      if(execlp(firstCommand, firstCommand, NULL) == -1) {
        perror("1st execlp");
        exit(1);
      }
    }

    if(pid2 = fork()) {
      wait(&status2);
      if(status2 != 0) {
        exit(1);
      }
    } else {
      if(execlp(secondCommand, secondCommand, NULL) == -1) {
       perror("2nd execlp");
       exit(1);
      }
    }

    exit(0);
}
