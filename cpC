#include <unistd.h>
#include <fcntl.h>
#include <sys/types.h>
#include <sys/stat.h>
#include <stdio.h>

int main (int argc, char* argv[]) {

  int sourceFile, destFile;
  ssize_t bytesR = 1, bytesW;
  char buffer[1024];
  sourceFile = open(argv[1], O_RDONLY);
  if(sourceFile == -1) {
    printf("Error while opening");
    return 1;
  }

  destFile = open(argv[2], O_CREAT | O_WRONLY | O_TRUNC, 0744);
  if(destFile == -1) {
    printf("Error while opening");
    return 1;
  }

  while(bytesR > 0) {
   bytesR = read(sourceFile, buffer, 1024);
   bytesW = write(destFile, buffer, bytesR);

    if(bytesR == -1) {
      printf("Error while copying");
      return 1;
    }
  }

  if(close(sourceFile) == -1 || close(destFile) == -1 ) {
    printf("Error while closing");
    return 1;
  }

  return 0;
}
