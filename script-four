#include <stdio.h>
#include <fcntl.h>
#include <sys/stat.h>
#include <sys/types.h>
#include <unistd.h>
#include <errno.h>
#include <stdlib.h>

#define N 1028;

int main(int argc, char* argv[]) {
   char* program = argv[0];
   char* command = argv[1];
   int i, status, pid;
   for(i = 1; i < argc; i++) {
    argv[i-1] = argv[i];
   }
   argv[argc - 1] = NULL;

   if( pid = fork()) {
   /* parent */
     wait(&status);
     printf("The number of the child %d and its finish code %d\n", pid, status);
   } else {
   /* child */
   if(execvp(command, argv) == -1) {
     perror("execvp");
     exit(1);
   }
   }

   return 0;
}
